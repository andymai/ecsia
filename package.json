{
  "name": "ecsia-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false",
    "typecheck:extras": "tsc -p examples/tsconfig.json && tsc -p examples/tsconfig.react.json && tsc -p bench/tsconfig.json && tsc -p demo/tsconfig.json && tsc -p embers/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "bench:macro": "BENCH_MACRO=1 vitest run --project bench",
    "bench:macro:pool": "BENCH_MACRO=1 vitest run --project bench bench/test/heavy-pool.smoke.test.ts",
    "bench:report": "node scripts/bench-report.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "smoke:browser:bundle": "node scripts/browser-smoke/build.mjs",
    "smoke:browser": "playwright test --config scripts/browser-smoke/playwright.config.ts",
    "size": "node scripts/size-check.mjs",
    "size:update": "node scripts/size-check.mjs --update",
    "demo:build": "node demo/build.mjs",
    "embers:build": "node embers/build.mjs",
    "embers:serve": "node scripts/browser-smoke/server.mjs --root website/public/embers --port 8898",
    "embers:e2e": "playwright test --config embers/e2e/playwright.config.ts",
    "demo:serve": "node scripts/browser-smoke/server.mjs --root website/public/demo --port 8899",
    "docs:api": "typedoc",
    "docs:check": "node scripts/check-doc-snippets.mjs",
    "docs:dev": "vitepress dev website",
    "docs:build": "pnpm docs:api && pnpm demo:build && pnpm embers:build && vitepress build website && pnpm docs:check"
  },
  "devDependencies": {
    "@ecsia/kit": "workspace:*",
    "@ecsia/scheduler": "workspace:*",
    "@ecsia/schema": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "4.1.10",
    "bitecs": "^0.4.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "miniplex": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tinybench": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "4.1.10"
  }
}
